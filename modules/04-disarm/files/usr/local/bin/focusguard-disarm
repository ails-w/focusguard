#!/usr/bin/env bash
set -euo pipefail

PHRASE="desarmar"
WAIT=60

# Este script NO sourcea policy.conf a proposito:
# debe funcionar incluso si la configuracion esta rota o a medio editar.
# shellcheck disable=SC1091
. /usr/local/lib/focusguard/common.sh

if [ "$(id -u)" -ne 0 ]; then
  echo "Ejecuta con sudo." >&2
  exit 1
fi

printf 'Esto DETIENE el bloqueo del usuario restringido.\nEscribe "%s" para confirmar: ' "$PHRASE"
read -r answer
if [ "$answer" != "$PHRASE" ]; then
  fg_audit "disarm-aborted"
  echo "Cancelado."
  exit 1
fi

echo "Desarmando en $WAIT s (Ctrl+C para abortar)..."
i=$WAIT
while [ "$i" -gt 0 ]; do
  printf '\r%d s... ' "$i"
  sleep 1
  i=$(( i - 1 ))
done
printf '\n'

systemctl stop focusguard-enforce.timer focusguard-integrity.timer
for live in /etc/focusguard/policy.conf /etc/security/time.conf; do
  chattr -i "$live" 2>/dev/null || true
done

fg_audit "disarm user=${SUDO_USER:-$(id -un)}"
echo "Desarmado. Timers detenidos e inmutabilidad quitada."
